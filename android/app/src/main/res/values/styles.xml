<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark by default, so the launch window is dark in both modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
    <!-- VpnToggleActivity: no window of its own, only the system consent dialog if needed. -->
    <style name="InvisibleTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>